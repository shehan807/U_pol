
molecule imidazole {
  0 1
  N    0.013     1.318    -0.157
  C   -1.180     0.682    -0.123
  C    1.114     0.544    -0.026
  C    1.023    -0.856     0.138
  N   -0.170    -1.493     0.172
  C   -1.271    -0.718     0.041
  H   -2.229    -1.218     0.067
  H   -2.066     1.292    -0.226
  H    2.072     1.043    -0.052
  H    1.908    -1.467     0.241
}

set {
basis def2-SVP
}

grad, wfn = optimize('pbe0', return_wfn=True)

fw = core.FCHKWriter(wfn)
fchkfile = 'molecule' + '.fchk'
fw.write(fchkfile)
