molecule pyrazole {
  units angstrom
  0 1
  N    0.059    -1.378     0.014
  N   -1.078    -0.655     0.015
  C    1.020    -0.471    -0.003
  C    0.509     0.861    -0.014
  C   -0.848     0.705    -0.001
