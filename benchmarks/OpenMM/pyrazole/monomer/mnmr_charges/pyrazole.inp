
molecule pyrazole {
  units angstrom
  0 1
  N    0.059    -1.378     0.014
  N   -1.078    -0.655     0.015
  C    1.020    -0.471    -0.003
  C    0.509     0.861    -0.014
  C   -0.848     0.705    -0.001
  H    1.050     1.797    -0.028
  H   -1.656     1.425    -0.003
  H   -1.978    -1.117     0.027
  H    2.048    -0.808    -0.008
}

set {
basis def2-SVP
}

grad, wfn = optimize('pbe0', return_wfn=True)

fw = core.FCHKWriter(wfn)
fchkfile = 'molecule' + '.fchk'
fw.write(fchkfile)
